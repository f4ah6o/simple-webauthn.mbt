name = "f4ah6o/simple-webauthn"

version = "0.2.0"

import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/x@0.5.5",
  "mizchi/js_core@0.13.0",
}

readme = "README.md"

repository = "https://github.com/f4ah6o/simple-webauthn.mbt"

license = "Apache-2.0 AND MIT"

keywords = [ "webauthn", "fido2", "authentication", "passkeys" ]

description = "WebAuthn (FIDO2) implementation for MoonBit - ported from SimpleWebAuthn"

source = "src"

preferred_target = "js"
